# SecureTunnel Linux 服务端环境变量
# 复制为 /etc/sectunnel/sectunnel.env 后按实际环境修改

# TUN 接口名（与 tunnel_server --tun 一致）
TUN_IF=sectun0

# 隧道内网网段与网关（服务端 TUN 地址）
TUN_NET=10.66.66.0/24
TUN_GW=10.66.66.1
TUN_PREFIX=24

# 出站网卡。留空则 apply-nat.sh 自动检测默认路由接口
WAN_IF=

# QUIC 监听端口（UDP）
QUIC_PORT=44333

# 允许 SSH 管理（生产建议改非 22 或限源 IP）
SSH_PORT=22

# 可选：限制 QUIC 入站来源（CIDR，留空表示任意）
# QUIC_ALLOW_CIDR=203.0.113.0/24

# tunnel_server 可执行文件路径
TUNNEL_SERVER_BIN=/usr/local/bin/tunnel_server

# TLS 证书（Linux 使用 PEM，非 Windows cert_hash）
TLS_CERT_FILE=/etc/sectunnel/certs/server.crt
TLS_KEY_FILE=/etc/sectunnel/certs/server.key

# 工作目录（含 inner PSK 等，权限 600）
TUNNEL_WORKDIR=/var/lib/sectunnel
