[Unit]
Description=SecureTunnel QUIC Server
Documentation=file:///usr/share/doc/sectunnel/LINUX_SERVER_DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/sectunnel/sectunnel.env
WorkingDirectory=/var/lib/sectunnel
ExecStartPre=/usr/local/lib/sectunnel/setup-tun.sh up
ExecStart=/bin/sh -c '${TUNNEL_SERVER_BIN} --quic --tun --relay --cert_file:${TLS_CERT_FILE} --key_file:${TLS_KEY_FILE}'
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# 创建 TUN 需要 CAP_NET_ADMIN；绑定 443 以下端口需额外配置
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
